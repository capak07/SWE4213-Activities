meta {
  name: 1 - GET Products - Not Logged In
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}products/
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer randomincorrecttoken
}

vars:pre-request {
  baseUrl: http://localhost:3000/
}

assert {
  res.status: eq 401
}

settings {
  encodeUrl: true
  timeout: 0
}

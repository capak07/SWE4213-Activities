meta {
  name: 3 - POST products
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "AirPods Pro (2nd Gen)",
    "price": 180,
    "condition": "good",
    "category": "Electronics",
    "description": "Works great. Includes case and extra tips.",
    "seller": "Ethan",
    "location": "Fredericton, NB"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
